soils <- read.csv("227106Q _Soil_speices.csv", skip = 1)

species_summary <- soils %>%
  group_by(Species)


species_summary

####boxplot for Ca/Mg Ratio

ggplot(data=species_summary, aes(x=Species, y=Ca/Mg, group = Species)) +
  geom_boxplot() + 
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1)
  )

